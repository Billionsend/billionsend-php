{
    "name": "billionsend/billionsend-php",
    "description": "PHP SDK for the BillionSend email API",
    "type": "library",
    "keywords": ["billionsend", "email", "api", "sdk", "inbox", "smtp", "transactional-email"],
    "homepage": "https://billionsend.com/docs",
    "license": "MIT",
    "authors": [{"name": "BillionSend"}],
    "support": {
        "issues": "https://github.com/billionsend/billionsend-php/issues",
        "source": "https://github.com/billionsend/billionsend-php",
        "docs": "https://billionsend.com/docs"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {"BillionSend\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"BillionSend\\Tests\\": "tests/"}
    },
    "scripts": {
        "generate": "php bin/generate.php",
        "check-generated": "php bin/generate.php --check",
        "sync-openapi": "php bin/sync-openapi.php",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
